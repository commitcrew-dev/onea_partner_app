# Copy this file to .env and adjust as needed. Only VITE_-prefixed keys reach the browser bundle.

# Base URL of the Node OneAPI service. Only used when VITE_USE_MOCKS=false.
VITE_API_URL=https://api.example.com

# Axios request timeout, in milliseconds.
VITE_API_TIMEOUT=20000

# Serve screens from src/mocks (in-memory db) instead of the real API.
# Set to false to hit VITE_API_URL directly.
VITE_USE_MOCKS=true

# Artificial delay (ms) added to mock responses, so loading/skeleton states are exercised.
VITE_MOCK_LATENCY=450

# Shown on Profile/About; sent as the X-Client-Version request header.
VITE_APP_VERSION=1.0.0

# Support line used by "Call Support".
VITE_SUPPORT_PHONE=+914446313131
